#!/usr/bin/env bash
# refueler-share pre-push hook (Share-Sync-1). Activated by: git config core.hooksPath bin/githooks
# Blocks any push to main unless refueler.io's PUSHED main already serves exactly this frontend.
# --no-verify skips this; .github/workflows/mirror-check.yml catches it anyway, loudly.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
ZERO="0000000000000000000000000000000000000000"
status=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$ZERO" ] && continue
  "$ROOT/bin/sync-share.sh" --verify-push "$local_sha" </dev/null || status=1
done
exit $status
