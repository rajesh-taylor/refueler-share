---
title: "Refueler Share — encrypted file transfer"
description: "Encrypted file transfer. Files are encrypted in the browser before upload. No account or email needed."
permalink: /index.html
activePage: ""
wordmarkSection: "Share"
---
<!DOCTYPE html>
<html lang="en">
<head>
{% set extraHead %}
<!-- F-23: marks a Share link before the modules load, so the upload screen never flashes.
     Safari-Slow-Link-1: also starts /meta (receiver) or preloads the upload modules. -->
<script src="/share-early.js"></script>
<link rel="stylesheet" href="/share.css">
<!-- Safari-Slow-Link-1: every module both pages need, fetched at once rather than one import level at a time -->
<link rel="modulepreload" href="/share.js">
<link rel="modulepreload" href="/crypto.js">
<link rel="modulepreload" href="/fragment.js">
<link rel="modulepreload" href="/download.js">
<!-- async, not defer: the modules no longer wait for it (upload.js waits for window.turnstile itself) -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async></script>
{% endset %}
{% include "head.njk" %}
<!-- ── Status banner (hidden until JS populates from /status) ─────────────── -->
<div class="status-banner hidden" id="status-banner" role="alert" aria-live="polite">
  <span class="status-banner-icon" id="status-banner-icon"></span>
  <span class="status-banner-text" id="status-banner-text"></span>
  <a class="status-banner-link" href="/share/status/" id="status-banner-link">View status →</a>
  <button class="status-banner-dismiss" id="status-banner-dismiss" aria-label="Dismiss">✕</button>
</div>

<script>
// ── Shared maintenance text formatter (used by banner + modal) ────────────────
function formatMaintenanceText(status) {
  const mw = status.maintenance;
  if (mw && mw.scheduled_at) {
    const dt = new Date(mw.scheduled_at * 1000);
    const formatted = dt.toLocaleString('en-GB', {
      weekday: 'short', day: 'numeric', month: 'short',
      hour: '2-digit', minute: '2-digit', timeZoneName: 'short',
    });
    const dur = mw.duration_minutes ? ` (${mw.duration_minutes} min)` : '';
    const desc = mw.description ? ` — ${mw.description}` : '';
    return `Scheduled maintenance: ${formatted}${dur}${desc}`;
  }
  return status.message ?? 'Maintenance in progress.';
}

// ── Maintenance modal (index.html only, maintenance state only) ───────────────
const MODAL_DISMISS_KEY = 'rs-maint-modal-dismissed';

function showMaintenanceModal(status) {
  try { if (sessionStorage.getItem(MODAL_DISMISS_KEY)) return; } catch {}
  const hash = window.location.hash.slice(1);
  // Suppress modal on any download link: v1 (non-empty opaque blob) or legacy (uuid=&key=)
  if (hash.length > 0) return;
  if (document.getElementById('maint-modal')) return;

  const overlay = document.createElement('div');
  overlay.id = 'maint-modal';
  overlay.setAttribute('role', 'dialog');
  overlay.setAttribute('aria-modal', 'true');
  overlay.setAttribute('aria-labelledby', 'maint-modal-heading');
  overlay.innerHTML = `
    <div class="maint-modal-card">
      <div class="maint-modal-icon">🔧</div>
      <h2 class="maint-modal-heading" id="maint-modal-heading">Scheduled maintenance</h2>
      <p class="maint-modal-body"></p>
      <button class="btn btn-primary btn-full maint-modal-dismiss" id="maint-modal-dismiss">Got it</button>
    </div>`;
  overlay.querySelector('.maint-modal-body').textContent = formatMaintenanceText(status);
  document.body.appendChild(overlay);

  const dismissBtn = document.getElementById('maint-modal-dismiss');
  dismissBtn.focus();

  function closeModal() {
    try { sessionStorage.setItem(MODAL_DISMISS_KEY, '1'); } catch {}
    overlay.remove();
  }

  dismissBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', e => { if (e.target === overlay) closeModal(); });
  overlay.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
}

// ── Status banner IIFE ────────────────────────────────────────────────────────
(function () {
  const WORKER_URL    = 'https://api.share.refueler.io';
  const DISMISS_KEY   = 'rs-banner-dismissed';
  const banner        = document.getElementById('status-banner');
  const bannerIcon    = document.getElementById('status-banner-icon');
  const bannerText    = document.getElementById('status-banner-text');
  const bannerDismiss = document.getElementById('status-banner-dismiss');

  bannerDismiss.addEventListener('click', () => {
    banner.classList.add('hidden');
    try { sessionStorage.setItem(DISMISS_KEY, '1'); } catch {}
  });

  async function loadStatus() {
    try { if (sessionStorage.getItem(DISMISS_KEY)) return; } catch {}

    let status;
    try {
      const res = await fetch(`${WORKER_URL}/status`, { cache: 'no-store' });
      if (!res.ok) return;
      status = await res.json();
    } catch {
      return;
    }

    const state = status.state ?? 'operational';
    if (state === 'operational') return;

    banner.dataset.state = state;

    if (state === 'maintenance') {
      bannerIcon.textContent = '🔧';
      bannerText.textContent = formatMaintenanceText(status);
      showMaintenanceModal(status);
    } else if (state === 'degraded') {
      bannerIcon.textContent = '⚠️';
      bannerText.textContent = status.message ?? 'Some services are degraded — we are investigating.';
    }

    banner.classList.remove('hidden');
  }

  loadStatus();
})();
</script>

{% include "shared-styles.njk" %}
</head>

<body>

{% include "nav.njk" %}
{% include "section-nav.njk" %}

<!-- ── Main shell ────────────────────────────────────────────────────── -->
<div class="shell">
  <main id="app">

    <!-- File inputs: outside the slip so they never catch drag events or clicks (S56).
         Opened by JS from "Choose a file" / "or a folder". -->
    <input type="file" id="file-input" aria-label="Select file" style="display:none" />
    <input type="file" id="folder-input" webkitdirectory multiple aria-label="Select folder" style="display:none" />

    <!-- ── Sender (Share-Upload-2) ──────────────────────────────────────────
         Design: docs/drafts/share-upload-mock-v3.html, decisions U-1…U-11.
         One sheet; share.js setView() sets data-view (empty · zipping · chosen ·
         over · uploading · ready · stopped) and share.css shows the parts for it.
         Same type rule as the receiver (R-1). Every id upload.js and the e2e test
         use is kept: drop-zone is the slip, file-btn "Choose a file", folder-btn
         "or a folder". -->
    <section class="rx-sheet up-sheet" id="upload-sheet" data-view="empty">
      <p class="rx-eyebrow" id="up-eyebrow">New transfer</p>
      <h1 class="rx-head" id="up-head">Send a file.</h1>

      <!-- Resume: shown on arrival when this browser has an unfinished upload -->
      <!-- One box (Share-Progress-1): the page headline says "An upload didn’t finish." -->
      <div class="up-panel hidden" id="resume-card">
        <dl class="rx-ledger">
          <div class="rx-row"><dt>File</dt><dd id="resume-file">—</dd></div>
          <div class="rx-row" id="resume-uploaded-row"><dt>Uploaded</dt><dd id="resume-uploaded">—</dd></div>
        </dl>
        <p class="rx-lede" id="resume-detail">Choose the same file to continue. This page only sees what you choose.</p>
        <div class="up-btnrow">
          <button class="rx-btn" id="resume-notice-btn" type="button">Choose file</button>
          <button class="rx-btn up-ghost" id="resume-discard-btn" type="button">Discard</button>
        </div>
      </div>

      <!-- The slip: the ledger in one hairline box; rows fill in place (U-7) -->
      <div class="up-slip" id="drop-zone">
        <dl class="rx-ledger">
          <div class="rx-row">
            <dt id="up-file-label">File</dt>
            <dd>
              <div class="up-for-empty">
                <span class="up-hint" id="up-hint">Drop it anywhere on this page</span>
                <div class="up-pick">
                  <button class="up-fill" id="file-btn" type="button">Choose a file</button>
                  <button class="up-link" id="folder-btn" type="button">or a folder</button>
                </div>
              </div>
              <div class="up-for-file">
                <span class="rx-fname"><span id="file-name-tag"></span><button class="up-link up-swap up-for-chosen" id="choose-another-btn" type="button">Choose another</button></span>
                <small id="up-file-note" hidden></small>
              </div>
            </dd>
          </div>
          <div class="rx-row up-for-zipping" id="zip-progress-card">
            <dt>Zipping</dt>
            <dd>
              <div class="rx-track"><b id="zip-bar"></b></div>
              <div class="rx-readout"><span id="zip-detail"></span><span id="zip-pct"></span></div>
            </dd>
          </div>
          <div class="rx-row up-not-zipping">
            <dt>Size</dt>
            <dd><span id="file-size-tag" class="up-dim">—</span>
              <!-- R-12: "4 GB" is FREE_CAP in frontend/crypto.js -->
              <small class="hidden" id="cap-warning">Free transfers go up to 4 GB. Paid plans for larger files aren’t open yet. <a class="up-link" href="/share/plans/">See plans</a></small></dd>
          </div>
          <div class="rx-row up-not-over">
            <dt>Available until</dt>
            <dd><span id="up-until" class="up-dim">7 days after upload</span><small id="up-until-note" hidden>7 days from upload</small></dd>
          </div>
          <div class="rx-row up-for-chosen">
            <dt>Password</dt>
            <dd>
              <label class="up-switch"><input type="checkbox" id="passphrase-toggle" /><span class="up-track"></span>Ask for a password</label>
              <div class="up-pwf hidden" id="passphrase-field-wrap">
                <input type="password" id="passphrase-input" aria-label="Password" autocomplete="new-password" />
                <small>Send it separately from the link. Refueler stores only a hash of it.</small>
              </div>
            </dd>
          </div>
          <div class="rx-row up-for-chosen" id="destroy-toggle-row">
            <dt>After download</dt>
            <dd>
              <label class="up-switch"><input type="checkbox" id="destroy-after-download" /><span class="up-track"></span>Delete the file</label>
              <p class="rx-once" id="destroy-notice" hidden>The link works once, then the file is deleted.</p>
            </dd>
          </div>
        </dl>
        <!-- R-12: "Free up to 4 GB" is FREE_CAP in frontend/crypto.js -->
        <p class="up-facts"><span>No account or email needed ·</span> <span>Encrypted in your browser · Free up to 4 GB</span></p>
      </div>

      <p class="rx-fine up-left up-for-zipping">Folders are zipped in your browser first, up to 2 GB.</p>
      <p class="up-msg hidden" id="drop-multi-msg" role="alert"></p>

      <!-- File chosen: the check and the button -->
      <div class="up-for-chosen" id="options-card">
        <div class="up-check hidden" id="turnstile-wrap">
          <p class="rx-fine up-left">A quick check by Cloudflare that you’re a person.</p>
          <div id="cf-turnstile"></div>
        </div>
        <div class="rx-actions">
          <button class="rx-btn" id="upload-btn" type="button" disabled>Encrypt and upload</button>
        </div>
        <!-- Paid-only options (availability window, permanent record) are injected here
             by upload.js and stay hidden until paid uploads open (F-10). -->
        <div id="paid-options" hidden></div>
      </div>

      <div class="rx-actions up-for-over">
        <button class="rx-btn up-ghost" id="over-another-btn" type="button">Choose another file</button>
      </div>

      <!-- Uploading: the receiver's measure -->
      <div class="rx-measure up-for-uploading" id="progress-card">
        <div class="rx-pct"><span id="progress-pct">0</span><sup>%</sup></div>
        <div class="rx-track" id="progress-track" role="progressbar" aria-label="Upload progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><b id="progress-bar"></b></div>
        <div class="rx-readout"><span id="progress-detail"></span><span>Keep this tab open</span></div>
      </div>
      <p class="rx-once up-for-uploading" id="progress-drop" role="status" hidden></p>

      <!-- Stopped -->
      <div class="up-for-stopped">
        <p class="rx-lede" id="up-stopped-text"></p>
        <div class="up-btnrow up-stop-actions">
          <button class="rx-btn" id="up-retry-btn" type="button" hidden>Try again</button>
          <button class="rx-btn up-ghost" id="up-restart-btn" type="button">Start over</button>
        </div>
      </div>

      <!-- Link ready -->
      <div class="up-for-ready" id="share-card">
        <p class="rx-lede">The key to the file is inside the link. Anyone who has the link can download the file, so send it only to the person it’s for.</p>
        <div class="up-linkbox" id="share-link-display"></div>
        <div class="up-btnrow">
          <button class="rx-btn" id="copy-btn" type="button">Copy link</button>
          <button class="rx-btn up-ghost" id="qr-btn" type="button" aria-expanded="false" aria-controls="qr-wrap">Show QR code</button>
        </div>
        <div class="up-qr" id="qr-wrap" hidden>
          <canvas id="qr-canvas" role="img" aria-label="QR code of the link"></canvas>
          <p>Scan with a phone’s camera to download it there.</p>
        </div>
        <dl class="rx-ledger" id="share-ledger"></dl>
        <p class="rx-send-wrap"><button class="rx-send" id="new-upload-btn" type="button"><span>Send another file</span></button></p>
      </div>
    </section>

    <!-- ── Receiver (Share-Receiver-2a/2b) ──────────────────────────────────
         Download mode only; download.js shows one sheet at a time.
         Type rule (R-1): serif = the one headline, mono capitals = labels,
         DM Sans = everything read. -->

    <!-- Ready card: also password, folder and timed-window variants -->
    <section class="rx-sheet" id="receiver-card" hidden>
      <p class="rx-eyebrow" id="rc-eyebrow">A file for you</p>
      <h1 class="rx-head" id="rc-head">Someone sent you a file.</h1>
      <dl class="rx-ledger">
        <div class="rx-row">
          <dt id="rc-name-label">File</dt>
          <dd><span class="rx-fname"><span id="rc-file-name">Encrypted file</span></span>
            <small id="rc-folder-note" hidden>A zipped folder. Unzip it after download.</small></dd>
        </div>
        <div class="rx-row"><dt>Size</dt><dd id="rc-size">—</dd></div>
        <div class="rx-row" id="rc-until-row"><dt>Available until</dt><dd><span id="rc-expiry">—</span><small id="rc-expiry-count"></small></dd></div>
        <div class="rx-row" id="rc-opens-row" hidden><dt>Opens</dt><dd><span id="rc-opens">—</span><small id="rc-opens-count"></small></dd></div>
        <div class="rx-row" id="rc-closes-row" hidden><dt>Closes</dt><dd id="rc-closes">—</dd></div>
        <div class="rx-row" id="rc-passphrase-row" hidden><dt>Password</dt><dd>Needed to download</dd></div>
      </dl>
      <div class="rx-actions">
        <button class="rx-btn" id="rc-download-btn" type="button">Download</button>
        <p class="rx-fine" id="usp-text">No account or email needed.</p>
      </div>
    </section>

    <!-- Password screen -->
    <section class="rx-sheet" id="unlock-screen" hidden>
      <p class="rx-eyebrow">Password needed</p>
      <h1 class="rx-head">This file has a password.</h1>
      <p class="rx-lede">The sender gives you this separately from the link.</p>
      <div class="rx-field">
        <label for="unlock-input">Password</label>
        <input type="password" id="unlock-input" autocomplete="current-password" aria-describedby="unlock-error" />
      </div>
      <p class="rx-err" id="unlock-error" role="alert"></p>
      <div class="rx-actions">
        <button class="rx-btn" id="unlock-btn" type="button">Unlock and download</button>
        <p class="rx-fine">No account or email needed.</p>
      </div>
    </section>

    <!-- Downloading -->
    <section class="rx-sheet" id="download-card" hidden>
      <p class="rx-eyebrow" id="dl-stage-tag">Downloading</p>
      <h1 class="rx-head">Downloading.</h1>
      <div class="rx-measure">
        <div class="rx-pct"><span id="dl-pct">0</span><sup>%</sup></div>
        <div class="rx-track" id="dl-track" role="progressbar" aria-label="Download progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><b id="dl-bar"></b></div>
        <div class="rx-readout"><span id="dl-mb"></span><span>Keep this tab open</span></div>
      </div>
      <p class="rx-once" id="dl-drop" role="status" hidden></p>
    </section>

    <!-- Finished -->
    <section class="rx-sheet" id="rx-done" hidden>
      <p class="rx-eyebrow">Complete</p>
      <h1 class="rx-head">Downloaded.</h1>
      <dl class="rx-ledger">
        <div class="rx-row"><dt id="rx-done-name-label">File</dt><dd><span class="rx-fname"><span id="rx-done-name">Encrypted file</span></span></dd></div>
        <div class="rx-row"><dt>Size</dt><dd id="rx-done-size">—</dd></div>
      </dl>
      <p class="rx-once" id="rx-done-deleted" hidden>Transfer permanently deleted from Refueler's servers.</p>
      <!-- R-12: "free up to 4 GB" is FREE_CAP in frontend/crypto.js. If the free
           limit ever drops below 4 GB, change both send lines (here and on the
           dead-link notice, below) and the upload page's "Free up to 4 GB" (drop zone). -->
      <p class="rx-send-wrap" id="dl-signoff"><a class="rx-send" href="/share/"><span>Send your own file, free up to 4 GB →</span></a></p>
    </section>

    <!-- Closed window, dead link, stopped download. Send line: dead link only (item 11). -->
    <section class="rx-sheet" id="rx-notice" hidden>
      <p class="rx-eyebrow" id="rx-notice-eyebrow"></p>
      <h1 class="rx-head" id="rx-notice-head"></h1>
      <p class="rx-lede" id="rx-notice-lede"></p>
      <p class="rx-send-wrap" id="rx-notice-send" hidden><a class="rx-send" href="/share/"><span>Send your own file, free up to 4 GB →</span></a></p>
    </section>

  </main>
</div>

{% include "footer.njk" %}

<!-- fflate + qr-creator self-hosted (S56 — cdnjs blocked). defer, not blocking  -->
<!-- (Safari-Slow-Link-1): deferred scripts run in order before the module script, -->
<!-- so the globals are still defined before share.js executes.                    -->
<script src="/fflate.min.js" defer></script>
<script src="/qr-creator.min.js" defer></script>
<script type="module" src="/share.js"></script>
</body>
</html>
