<!DOCTYPE html>
<html lang="en">
<head>
{% set extraHead %}
<link rel="stylesheet" href="/share.css">
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onTurnstileLoad" defer></script>
{% endset %}
{% include "head.njk" %}
<!-- ── Status banner (hidden until JS populates from /status) ─────────────── -->
<div class="status-banner hidden" id="status-banner" role="alert" aria-live="polite">
  <span class="status-banner-icon" id="status-banner-icon"></span>
  <span class="status-banner-text" id="status-banner-text"></span>
  <a class="status-banner-link" href="/share/status/" id="status-banner-link">View status →</a>
  <button class="status-banner-dismiss" id="status-banner-dismiss" aria-label="Dismiss">✕</button>
</div>

<script>
// ── Shared maintenance text formatter (used by banner + modal) ────────────────
function formatMaintenanceText(status) {
  const mw = status.maintenance;
  if (mw && mw.scheduled_at) {
    const dt = new Date(mw.scheduled_at * 1000);
    const formatted = dt.toLocaleString('en-GB', {
      weekday: 'short', day: 'numeric', month: 'short',
      hour: '2-digit', minute: '2-digit', timeZoneName: 'short',
    });
    const dur = mw.duration_minutes ? ` (${mw.duration_minutes} min)` : '';
    const desc = mw.description ? ` — ${mw.description}` : '';
    return `Scheduled maintenance: ${formatted}${dur}${desc}`;
  }
  return status.message ?? 'Maintenance in progress.';
}

// ── Maintenance modal (index.html only, maintenance state only) ───────────────
const MODAL_DISMISS_KEY = 'rs-maint-modal-dismissed';

function showMaintenanceModal(status) {
  try { if (sessionStorage.getItem(MODAL_DISMISS_KEY)) return; } catch {}
  const hash = window.location.hash.slice(1);
  // Suppress modal on any download link: v1 (non-empty opaque blob) or legacy (uuid=&key=)
  if (hash.length > 0) return;
  if (document.getElementById('maint-modal')) return;

  const overlay = document.createElement('div');
  overlay.id = 'maint-modal';
  overlay.setAttribute('role', 'dialog');
  overlay.setAttribute('aria-modal', 'true');
  overlay.setAttribute('aria-labelledby', 'maint-modal-heading');
  overlay.innerHTML = `
    <div class="maint-modal-card">
      <div class="maint-modal-icon">🔧</div>
      <h2 class="maint-modal-heading" id="maint-modal-heading">Scheduled maintenance</h2>
      <p class="maint-modal-body"></p>
      <button class="btn btn-primary btn-full maint-modal-dismiss" id="maint-modal-dismiss">Got it</button>
    </div>`;
  overlay.querySelector('.maint-modal-body').textContent = formatMaintenanceText(status);
  document.body.appendChild(overlay);

  const dismissBtn = document.getElementById('maint-modal-dismiss');
  dismissBtn.focus();

  function closeModal() {
    try { sessionStorage.setItem(MODAL_DISMISS_KEY, '1'); } catch {}
    overlay.remove();
  }

  dismissBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', e => { if (e.target === overlay) closeModal(); });
  overlay.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
}

// ── Status banner IIFE ────────────────────────────────────────────────────────
(function () {
  const WORKER_URL    = 'https://api.share.refueler.io';
  const DISMISS_KEY   = 'rs-banner-dismissed';
  const banner        = document.getElementById('status-banner');
  const bannerIcon    = document.getElementById('status-banner-icon');
  const bannerText    = document.getElementById('status-banner-text');
  const bannerDismiss = document.getElementById('status-banner-dismiss');

  bannerDismiss.addEventListener('click', () => {
    banner.classList.add('hidden');
    try { sessionStorage.setItem(DISMISS_KEY, '1'); } catch {}
  });

  async function loadStatus() {
    try { if (sessionStorage.getItem(DISMISS_KEY)) return; } catch {}

    let status;
    try {
      const res = await fetch(`${WORKER_URL}/status`, { cache: 'no-store' });
      if (!res.ok) return;
      status = await res.json();
    } catch {
      return;
    }

    const state = status.state ?? 'operational';
    if (state === 'operational') return;

    banner.dataset.state = state;

    if (state === 'maintenance') {
      bannerIcon.textContent = '🔧';
      bannerText.textContent = formatMaintenanceText(status);
      showMaintenanceModal(status);
    } else if (state === 'degraded') {
      bannerIcon.textContent = '⚠️';
      bannerText.textContent = status.message ?? 'Some services are degraded — we are investigating.';
    }

    banner.classList.remove('hidden');
  }

  loadStatus();
})();
</script>

{% include "shared-styles.njk" %}
</head>

<body>

{% include "nav.njk" %}

<!-- ── Main shell ────────────────────────────────────────────────────── -->
<div class="shell">
  <main id="app">

    <!-- Info card — lock line (existing) -->
    <div class="info-card" id="info-card">
      <span class="info-icon">🔒</span>
      <span>No account. No email. No history. Files are encrypted in your browser before upload. Only you hold the key.</span>
      <button class="info-card-dismiss" id="dismiss-info" aria-label="Dismiss">✕</button>
    </div>

    <!-- File inputs — outside the drop zone so they never intercept drag events   -->
    <!-- or block button clicks. Triggered programmatically by JS click handlers.  -->
    <!-- S56: moved from inside drop-zone where position:absolute caused conflicts. -->
    <input type="file" id="file-input" aria-label="Select file" style="display:none" />
    <input type="file" id="folder-input" webkitdirectory multiple aria-label="Select folder" style="display:none" />

    <!-- Drop zone -->
    <div class="drop-zone" id="drop-zone">
      <div class="drop-icon">↑</div>
      <div class="drop-label">Drop a file or folder here</div>
      <div class="drop-sub mt4">End-to-end encrypted · Free up to 4 GB</div>
      <div class="drop-folder-row mt12">
        <button class="btn btn-ghost btn-sm" id="file-btn" type="button">📄 Browse file</button>
        <button class="btn btn-ghost btn-sm" id="folder-btn" type="button">📁 Upload folder</button>
      </div>
    </div>

    <!-- Secondary nav — Plans + Status (HQ2) ──────────────────────────────────
         Sits below the drop zone. Hidden when a file is selected.
         Styled to match .site-nav register — display, uppercase, fg-muted.     -->
    <div class="share-subnav" id="share-subnav">
      <a href="/share/plans/" class="share-subnav-link">Plans</a>
      <span class="share-subnav-dot">·</span>
      <a href="/share/status/" class="share-subnav-link">Status</a>
    </div>

    <!-- Zip progress card (shown while compressing a folder, before upload progress) -->
    <div class="card hidden" id="zip-progress-card">
      <div class="flex-row">
        <span class="tag" id="zip-stage-tag">Compressing</span>
        <span class="muted small" id="zip-pct">0%</span>
      </div>
      <div class="progress-bar-wrap">
        <div class="progress-bar" id="zip-bar"></div>
      </div>
      <div class="progress-label mt4" id="zip-detail"></div>
    </div>

    <!-- Resume card (RU1) — shown on page load if an interrupted transfer is found in IndexedDB.
     Place this immediately AFTER the zip-progress-card div in index.njk.
     Hidden by default; revealed by checkResumeState() in share.js. -->
  <div id="resume-card" class="card hidden" style="margin-top: 1rem;">
  <div class="card-inner" style="padding: 1.25rem 1.5rem;">
    <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.75rem;">
      <span class="stage-tag" style="background:var(--gold); color:var(--carbon); font-size:0.7rem; padding:0.2em 0.6em; border-radius:2px; letter-spacing:0.06em; text-transform:uppercase; font-family:var(--mono);">Interrupted</span>
      <span style="font-family:var(--mono); font-size:0.8rem; color:var(--muted);">Transfer paused</span>
    </div>
    <p id="resume-detail" style="font-family:var(--mono); font-size:0.82rem; color:var(--text); margin:0 0 1rem; line-height:1.5;"></p>
        <p id="resume-note" class="hidden" style="font-family:var(--mono); font-size:0.78rem; color:var(--muted); margin:0 0 0.75rem; font-style:italic;">Chunks already sent are encrypted.</p>
    <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
      <button id="resume-notice-btn" class="btn btn-primary" style="min-width:7rem;">Resume</button>
      <button id="resume-discard-btn" class="btn btn-ghost" style="min-width:7rem;">Discard</button>
    </div>
  </div>
</div>


    <!-- Cap warning + upgrade nudge -->
    <div id="cap-warning" class="card hidden">
      <p class="cap-warn">This file is over the 4 GB free limit.</p>
      <p class="muted small mt4">Creative Premium supports transfers up to 100 GB — <a href="/share/plans/" class="upgrade-nudge-link">see plans →</a></p>
    </div>

    <!-- Options card (shown after file selected) -->
    <div class="card hidden" id="options-card">
      <div class="flex-row" id="file-summary">
        <span class="tag" id="file-name-tag"></span>
        <span class="muted small" id="file-size-tag"></span>
      </div>
      <!-- Turnstile — visible managed widget, shown after file selected -->
      <div class="mt16 turnstile-wrap hidden" id="turnstile-wrap">
        <div id="cf-turnstile"></div>
      </div>
      <!-- Passphrase toggle -->
      <div class="mt16">
        <div class="toggle-row">
          <div>
            <div class="toggle-label">Protect with password</div>
            <div class="toggle-desc">Recipient must enter a password to download</div>
          </div>
          <label class="switch">
            <input type="checkbox" id="passphrase-toggle" />
            <span class="slider"></span>
          </label>
        </div>
      </div>
      <div class="hidden" id="passphrase-field-wrap">
        <div class="field mt12">
          <label for="passphrase-input">Password</label>
          <input type="password" id="passphrase-input" placeholder="Choose a strong password" autocomplete="new-password" />
        </div>
        <div class="muted small mt4">Share this separately. We never store it.</div>
      </div>
      <div class="mt16">
        <button class="btn btn-primary btn-full" id="upload-btn" disabled>Encrypt &amp; upload</button>
      </div>
    </div>

    <!-- Progress card -->
    <div class="card hidden" id="progress-card">
      <div class="flex-row">
        <span class="tag" id="progress-stage-tag">Preparing</span>
        <span class="muted small" id="progress-pct">0%</span>
      </div>
      <div class="progress-bar-wrap">
        <div class="progress-bar" id="progress-bar"></div>
      </div>
      <div class="progress-label mt4" id="progress-detail"></div>
    </div>

    <!-- Share link panel -->
    <div class="card hidden" id="share-card">
      <div class="flex-row">
        <span class="success-txt small mono">✓</span>
        <span style="font-size:14px;font-weight:500">Ready to share</span>
      </div>
      <div class="link-box" id="share-link-display"></div>
      <div class="share-btn-row mt12">
        <button class="btn btn-primary" id="copy-btn"><svg width="13" height="13" viewBox="0 0 13 13" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:inline-block;vertical-align:-1px;margin-right:5px" aria-hidden="true"><rect x="4" y="4" width="8" height="8" rx="1.2" stroke="currentColor" stroke-width="1.25"/><path d="M3 9H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v1" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/></svg>Copy link</button>
        <button class="btn btn-ghost" id="new-upload-btn">New upload</button>
      </div>
      <div id="qr-wrap"></div>
    </div>

    <!-- ── Receiver (Share-Receiver-2a/2b) ──────────────────────────────────
         Download mode only; download.js shows one sheet at a time.
         Type rule (R-1): serif = the one headline, mono capitals = labels,
         DM Sans = everything read. -->

    <!-- Ready card: also password, folder and timed-window variants -->
    <section class="rx-sheet" id="receiver-card" hidden>
      <p class="rx-eyebrow" id="rc-eyebrow">A file for you</p>
      <h1 class="rx-head" id="rc-head">Someone sent you a file.</h1>
      <dl class="rx-ledger">
        <div class="rx-row">
          <dt id="rc-name-label">File</dt>
          <dd><span class="rx-fname"><span id="rc-file-name">Encrypted file</span></span>
            <small id="rc-folder-note" hidden>A zipped folder. Unzip it after download.</small></dd>
        </div>
        <div class="rx-row"><dt>Size</dt><dd id="rc-size">—</dd></div>
        <div class="rx-row" id="rc-until-row"><dt>Available until</dt><dd><span id="rc-expiry">—</span><small id="rc-expiry-count"></small></dd></div>
        <div class="rx-row" id="rc-opens-row" hidden><dt>Opens</dt><dd><span id="rc-opens">—</span><small id="rc-opens-count"></small></dd></div>
        <div class="rx-row" id="rc-closes-row" hidden><dt>Closes</dt><dd id="rc-closes">—</dd></div>
        <div class="rx-row" id="rc-passphrase-row" hidden><dt>Password</dt><dd>Needed to download</dd></div>
      </dl>
      <div class="rx-actions">
        <button class="rx-btn" id="rc-download-btn" type="button">Download</button>
        <p class="rx-fine" id="usp-text">No account or email needed.</p>
      </div>
    </section>

    <!-- Password screen -->
    <section class="rx-sheet" id="unlock-screen" hidden>
      <p class="rx-eyebrow">Password needed</p>
      <h1 class="rx-head">This file has a password.</h1>
      <p class="rx-lede">The sender gives you this separately from the link.</p>
      <div class="rx-field">
        <label for="unlock-input">Password</label>
        <input type="password" id="unlock-input" autocomplete="current-password" aria-describedby="unlock-error" />
      </div>
      <p class="rx-err" id="unlock-error" role="alert"></p>
      <div class="rx-actions">
        <button class="rx-btn" id="unlock-btn" type="button">Unlock and download</button>
        <p class="rx-fine">No account or email needed.</p>
      </div>
    </section>

    <!-- Downloading -->
    <section class="rx-sheet" id="download-card" hidden>
      <p class="rx-eyebrow" id="dl-stage-tag">Downloading</p>
      <h1 class="rx-head">Downloading.</h1>
      <div class="rx-measure">
        <div class="rx-pct"><span id="dl-pct">0</span><sup>%</sup></div>
        <div class="rx-track" id="dl-track" role="progressbar" aria-label="Download progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><b id="dl-bar"></b></div>
        <div class="rx-readout"><span id="dl-mb"></span><span>Keep this tab open</span></div>
      </div>
    </section>

    <!-- Finished -->
    <section class="rx-sheet" id="rx-done" hidden>
      <p class="rx-eyebrow">Complete</p>
      <h1 class="rx-head">Downloaded.</h1>
      <dl class="rx-ledger">
        <div class="rx-row"><dt id="rx-done-name-label">File</dt><dd><span class="rx-fname"><span id="rx-done-name">Encrypted file</span></span></dd></div>
        <div class="rx-row"><dt>Size</dt><dd id="rx-done-size">—</dd></div>
      </dl>
      <p class="rx-once" id="rx-done-deleted" hidden>Transfer permanently deleted from Refueler's servers.</p>
      <!-- R-12: "free up to 4 GB" is FREE_CAP in frontend/crypto.js. If the free
           limit ever drops below 4 GB, change both send lines (here and on the
           dead-link notice, below) and the upload page's "Free up to 4 GB" (drop zone). -->
      <p class="rx-send-wrap" id="dl-signoff"><a class="rx-send" href="/share/"><span>Send your own file, free up to 4 GB →</span></a></p>
    </section>

    <!-- Closed window, dead link, stopped download. Send line: dead link only (item 11). -->
    <section class="rx-sheet" id="rx-notice" hidden>
      <p class="rx-eyebrow" id="rx-notice-eyebrow"></p>
      <h1 class="rx-head" id="rx-notice-head"></h1>
      <p class="rx-lede" id="rx-notice-lede"></p>
      <p class="rx-send-wrap" id="rx-notice-send" hidden><a class="rx-send" href="/share/"><span>Send your own file, free up to 4 GB →</span></a></p>
    </section>

    <!-- Drop zone multi-file rejection message -->
    <div class="hidden" id="drop-multi-msg" role="alert"></div>

  </main>
</div>

<!-- ── HTTP/3 infrastructure whisper — HQ2 ──────────────────────────────── -->
<!-- Static, always visible. Above footer. Not part of the upload flow.       -->
<div class="http3-whisper">
  <span class="http3-whisper-text">Delivered over Cloudflare HTTP/3.</span>
</div>
<div data-refueler-badge="compact"></div>
{% include "footer.njk" %}

<!-- fflate + qr-creator self-hosted (S56 — cdnjs blocked). Blocking scripts so  -->
<!-- globals are defined before the module script executes.                        -->
<script src="/fflate.min.js"></script>
<script src="/qr-creator.min.js"></script>
<script type="module" src="/share.js"></script>
<script type="module" src="/refueler-badge.js"></script>
<script>
// ── Share subnav hide on file select — HQ2 ───────────────────────────────────
// Watches for options-card becoming visible (share.js removes 'hidden' class).
// When a file is selected the subnav hides with the rest of the pre-upload chrome.
(function () {
  const subnav     = document.getElementById('share-subnav');
  const optionsCard = document.getElementById('options-card');
  if (!subnav || !optionsCard) return;

  const observer = new MutationObserver(() => {
    const fileSelected = !optionsCard.classList.contains('hidden');
    subnav.classList.toggle('hidden', fileSelected);
  });
  observer.observe(optionsCard, { attributes: true, attributeFilter: ['class'] });
})();
</script>
</body>
</html>
