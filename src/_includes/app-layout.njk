{#- app-layout.njk — share.refueler.io standalone layout (X5-1 · 14 Oct 2026).
    docs/X5-plan-v1.md §2.2–§2.5. Pages {% extends %} this and fill the blocks.
    No refueler.io nav/footer/section pill, no Google/Fontshare CSS, no inline
    script, no on*= and no style= anywhere (ship-app.sh refuses the build if so).
    assetBase = /v/<shortsha> (eleventy.app.js) — every JS/CSS/font/icon lives
    under it; only HTML and manifest.webmanifest sit at the root. -#}
<!DOCTYPE html>
<html lang="en" data-theme="carbon">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>{{ title }}</title>
<meta name="description" content="{{ description }}" />
<meta name="robots" content="noindex, nofollow" />
<meta name="referrer" content="no-referrer" />
<meta name="color-scheme" content="dark light" />
<meta name="theme-color" content="#1A1917" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="icon" href="{{ assetBase }}/icons/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="{{ assetBase }}/icons/apple-touch-icon.png" />
<script src="{{ assetBase }}/theme-early.js"></script>
<link rel="preload" href="{{ assetBase }}/fonts/source-serif-4-300.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="{{ assetBase }}/fonts/dm-sans-var.woff2" as="font" type="font/woff2" crossorigin />
{% block head %}{% endblock %}
<link rel="stylesheet" href="{{ assetBase }}/share-tokens.css" />
<link rel="stylesheet" href="{{ assetBase }}/share.css" />
<link rel="stylesheet" href="{{ assetBase }}/app.css" />
</head>

<body class="app{% if bodyClass %} {{ bodyClass }}{% endif %}">

<header class="app-head">
  <span class="app-brand">
    <a class="app-mark" href="/" aria-label="Refueler Share, send a file">Refueler<span>Share</span></a>
    <span class="stage-chip"></span>
  </span>
  <span class="app-head-r">
    {% if accountSlot %}<a class="app-account" id="app-account" href="/signin/" hidden></a>{% endif %}
    <button class="app-theme" id="app-theme" type="button" aria-label="Switch theme"></button>
  </span>
</header>

{% if statusLine %}
<div class="app-status" id="app-status" role="status" hidden>
  <span id="app-status-text"></span>
  <a href="https://refueler.io/share/status/">View status</a>
  <button type="button" id="app-status-close">Close</button>
</div>
{% endif %}

<div class="shell">
  <main id="app">
{% block main %}{% endblock %}
  </main>
</div>

{% block scripts %}{% endblock %}
<script type="module" src="{{ assetBase }}/app-header.js"></script>
</body>
</html>
