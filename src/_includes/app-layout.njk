{#- app-layout.njk — share.refueler.io standalone layout (X5-1 · 14 Oct 2026).
    docs/X5-plan-v1.md §2.2–§2.5. Pages {% extends %} this and fill the blocks.
    No refueler.io nav/footer/section pill, no Google/Fontshare CSS, no inline
    script, no on*= and no style= anywhere (ship-app.sh refuses the build if so).
    assetBase = /v/<shortsha> (eleventy.app.js) — every JS/CSS/font/icon lives
    under it; only HTML and manifest.webmanifest sit at the root. -#}
<!DOCTYPE html>
<html lang="en" data-theme="carbon">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>{{ title }}</title>
<meta name="description" content="{{ description }}" />
<meta name="robots" content="noindex, nofollow" />
<meta name="referrer" content="no-referrer" />
<meta name="color-scheme" content="dark light" />
<meta name="theme-color" content="#1A1917" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="icon" href="{{ assetBase }}/icons/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="{{ assetBase }}/icons/apple-touch-icon.png" />
<script src="{{ assetBase }}/theme-early.js"></script>
<link rel="preload" href="{{ assetBase }}/fonts/source-serif-4-300.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="{{ assetBase }}/fonts/dm-sans-var.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="{{ assetBase }}/fonts/Satoshi-Variable.woff2" as="font" type="font/woff2" crossorigin />
{% block head %}{% endblock %}
<link rel="stylesheet" href="{{ assetBase }}/share-tokens.css" />
<link rel="stylesheet" href="{{ assetBase }}/share.css" />
<link rel="stylesheet" href="{{ assetBase }}/app.css" />
</head>

<body class="app{% if bodyClass %} {{ bodyClass }}{% endif %}">

<!-- Header (X5-1a, Rajesh 14 Oct): one refueler.io-style row — "Refueler / Share" in Satoshi,
     the refueler.io site links (absolute; plain navigations), the account slot
     and the CARBON / PAPER pill. No section pill: Plans and Status live in the footer.
     Rebuilt in the app's own files (app.css, app-header.js) — no refueler.io CSS/JS, no onclick. -->
<header class="site-header" id="site-header">
  <div class="header-inner">
    <span class="app-brand">
      <a href="/" class="wordmark" aria-label="Refueler Share, send a file">Refueler<span class="wordmark-divider">/</span><span class="wordmark-section">Share</span></a>
    </span>
    <nav class="site-nav" aria-label="Refueler">
      <a href="/" class="active nav-here">Share</a>
      <a href="https://refueler.io/legend/">Legend</a>
      <a href="https://refueler.io/notes/">Notes</a>
      <a href="https://refueler.io/editorial/" class="nav-secondary">Editorial</a>
      <a href="https://refueler.io/support/" class="nav-secondary">Support</a>
      <a href="https://refueler.io/privacy/" class="nav-secondary">Privacy</a>
      {% if accountSlot %}<a class="app-account" id="app-account" href="/signin/" hidden></a>{% endif %}
      <button class="nav-hamburger" id="nav-hamburger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-drawer"><span></span><span></span><span></span></button>
      <button class="theme-pill" id="app-theme" type="button" aria-label="Switch between Carbon and Paper">Carbon / Paper</button>
    </nav>
  </div>
  <div class="nav-drawer" id="nav-drawer">
    <a href="/" class="active">Share</a>
    <a href="https://refueler.io/legend/">Legend</a>
    <a href="https://refueler.io/notes/">Notes</a>
    <a href="https://refueler.io/editorial/">Editorial</a>
    <a href="https://refueler.io/support/">Support</a>
    <a href="https://refueler.io/privacy/">Privacy</a>
    {% if accountSlot %}<a class="app-account drawer-account" id="app-account-drawer" href="/signin/" hidden></a>{% endif %}
    <button class="theme-pill drawer-theme" id="app-theme-drawer" type="button" aria-label="Switch between Carbon and Paper">Carbon / Paper</button>
  </div>
</header>

{% if statusLine %}
<div class="app-status" id="app-status" role="status" hidden>
  <span id="app-status-text"></span>
  <a href="https://refueler.io/share/status/">View status</a>
  <button type="button" id="app-status-close">Close</button>
</div>
{% endif %}

<div class="shell">
  <main id="app">
{% block main %}{% endblock %}
  </main>
</div>

<footer class="app-foot">
  <nav aria-label="More">
    <a href="https://refueler.io/share/plans/">Plans</a>
    <a href="https://refueler.io/share/status/">Status</a>
    <a href="https://refueler.io/privacy/">Privacy</a>
    <a href="https://refueler.io/support/">Support</a>
  </nav>
  <span>© 2026 Refueler Ltd (incorporating) · refueler.io</span>
</footer>

{% block scripts %}{% endblock %}
<script type="module" src="{{ assetBase }}/app-header.js"></script>
</body>
</html>
